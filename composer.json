{
    "name": "vspace/ibexport",
    "description": "Bitrix module: export/import of iblock elements and sections, incl. Yandex.Disk transfer channel",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Vspace\\Ibexport\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vspace\\Ibexport\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
